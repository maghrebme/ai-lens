# ==========================================================================
# Ai-Lens — runtime configuration (SERVER)
# Copy to .env and adjust. Shell environment variables always take priority.
# ==========================================================================

# Environment type (local or server)
ENV_TYPE=server

# Server settings
HOST=0.0.0.0
PORT=8420

# Public base path. Empty when served at the root; set to /ai-lens when the
# site is mounted behind a reverse proxy at http://host/ai-lens/
BASE_PATH=/ai-lens

# Paths (absolute, or relative to the project root)
DATA_PATH=/var/lib/ai-lens/data
LOG_PATH=/var/log/ai-lens

# Content
DEFAULT_LANG=ar
REFRESH_MINUTES=720
RETENTION_DAYS=45

# Optional bilingual enrichment with Claude (translated headlines + summaries).
# Needs `pip install -r python/requirements.txt` and ANTHROPIC_API_KEY (or an
# `ant auth login` profile). ENRICH=off disables it entirely.
ENRICH=auto
ENRICH_MODEL=claude-opus-5-5
ENRICH_MAX_PER_REFRESH=120
# ANTHROPIC_API_KEY=
